{
  "name": "workforcepro",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Multi-Tenant Workforce Management SaaS",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/admin"
  ],
  "scripts": {
    "build:contracts": "npm --workspace=@workforcepro/api-contracts run build",
    "build:api": "npm --workspace=@workforcepro/api run build",
    "build:admin": "npm --workspace=@workforcepro/admin run build",
    "build": "npm run build:contracts && npm run build:api && npm run build:admin",
    "test:contracts": "npm --workspace=@workforcepro/api-contracts run test",
    "test:api": "npm --workspace=@workforcepro/api run test",
    "test:admin": "npm --workspace=@workforcepro/admin run test",
    "test:mobile": "npm run mobile:test",
    "test": "npm run test:contracts && npm run test:api && npm run test:admin",
    "lint:api": "npm --workspace=@workforcepro/api run lint",
    "lint:admin": "npm --workspace=@workforcepro/admin run lint",
    "lint:contracts": "npm --workspace=@workforcepro/api-contracts run lint",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,css}\" \"packages/**/*.{ts,json}\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css}\" \"packages/**/*.{ts,json}\"",
    "typecheck": "npm --workspace=@workforcepro/api-contracts run typecheck && npm --workspace=@workforcepro/api run typecheck && npm --workspace=@workforcepro/admin run typecheck",
    "dev:contracts": "npm --workspace=@workforcepro/api-contracts run dev",
    "dev:api": "npm --workspace=@workforcepro/api run dev",
    "dev:admin": "npm --workspace=@workforcepro/admin run dev",
    "mobile:analyze": "cd apps/mobile && flutter analyze",
    "mobile:test": "cd apps/mobile && flutter test"
  },
  "keywords": [
    "workforce-management",
    "multi-tenant",
    "attendance",
    "payroll",
    "geofencing"
  ],
  "author": "WorkforcePro Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}
